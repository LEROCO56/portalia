# ============ PORTALIA — variables de entorno ============
# Copiar a .env y llenar. Nunca commitear .env real.

# Supabase (auth + DB + storage)
PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJxxx..."
SUPABASE_SERVICE_ROLE_KEY="eyJxxx..."   # secret — solo server-side

# Hotmart webhook (para gating de compras)
HOTMART_WEBHOOK_SECRET="una-cadena-larga-aleatoria"

# Anthropic API (para el auditor Portal IA en modo Pro)
ANTHROPIC_API_KEY="sk-ant-xxx"

# Site
PUBLIC_SITE_URL="https://portalia.com.co"
PUBLIC_HOTMART_CHECKOUT_URL="https://pay.hotmart.com/W107728674K?off=92xsf4mj"
