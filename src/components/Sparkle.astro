---
// Sparkle Anthropic-style — el asterisco de 4 puntas.
interface Props {
  size?: number;
  class?: string;
  color?: string;
}
const { size = 20, class: className = '', color = 'currentColor' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  fill="none"
  stroke={color}
  stroke-width="2.4"
  stroke-linecap="round"
>
  <line x1="12" y1="2" x2="12" y2="22" />
  <line x1="2" y1="12" x2="22" y2="12" />
  <line x1="4.9" y1="4.9" x2="19.1" y2="19.1" />
  <line x1="4.9" y1="19.1" x2="19.1" y2="4.9" />
</svg>
