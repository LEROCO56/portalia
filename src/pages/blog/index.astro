---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sparkle from '@/components/Sparkle.astro';

const posts = [
  { slug: 'aeo-colombia-2026', title: 'AEO en Colombia 2026 · panorama, oportunidades y quién está ganando', excerpt: '50 categorías analizadas. Dónde las IAs ya recomiendan negocios locales, dónde está la ventana.', date: '2026-09-23', minutes: 8, featured: true },
  { slug: 'errores-fatales-aeo', title: '10 errores fatales AEO que las webs LatAm cometen en 2026', excerpt: 'Los errores más frecuentes que hacen invisible tu negocio para ChatGPT y Perplexity. Con corrección.', date: '2026-09-23', minutes: 7, featured: true },
  { slug: 'como-aparecer-en-perplexity', title: 'Cómo aparecer en Perplexity: guía para negocios en Colombia', excerpt: 'Perplexity siempre muestra sus fuentes. Cómo preparar tu web para ser una de ellas.', date: '2026-09-23', minutes: 4 },
  { slug: 'como-medir-si-chatgpt-te-recomienda', title: 'Cómo medir si ChatGPT (y las otras IAs) recomiendan tu negocio', excerpt: 'Matriz 5 × 5 con puntaje 0-1-2 para medir cada mes si las IAs te citan.', date: '2026-09-23', minutes: 4 },
  { slug: 'google-business-profile-e-ias', title: 'Google Business Profile en la era de las IAs: qué sigue importando', excerpt: 'Los 6 ajustes de tu ficha de Google que siguen importando para Gemini y las demás IAs.', date: '2026-09-23', minutes: 4 },
  { slug: 'llms-txt-que-es-y-si-sirve', title: 'llms.txt: qué es, cómo se hace y si de verdad sirve', excerpt: 'Qué es el archivo llms.txt, cómo se hace y qué sabemos (y qué no) de su efecto.', date: '2026-09-23', minutes: 4 },
  { slug: 'que-es-aeo', title: '¿Qué es AEO (Answer Engine Optimization)?', excerpt: 'La disciplina para que las IAs recomienden tu negocio. Diferencia clara con SEO tradicional.', date: '2026-09-23', minutes: 5 },
  { slug: 'schema-org-para-negocios', title: 'Schema.org para negocios que quieren aparecer en ChatGPT', excerpt: 'Los 6 tipos de schema que más pesan para las IAs, con plantillas listas para copiar.', date: '2026-09-23', minutes: 8 },
  { slug: 'menciones-externas-sin-presupuesto', title: 'Cómo conseguir tus primeras 10 menciones externas sin presupuesto', excerpt: 'Playbook de 30 días para emprendedores solos. Sin PR, sin agencia.', date: '2026-09-23', minutes: 7 },
  { slug: 'chatgpt-vs-perplexity-vs-claude', title: 'ChatGPT vs Perplexity vs Claude · en cuál priorizar tu AEO', excerpt: 'Diferencias en cómo cada IA elige fuentes. Dónde poner el esfuerzo primero según tu negocio.', date: '2026-09-23', minutes: 6 },
  { slug: 'faqpage-que-si-funciona', title: 'FAQPage que sí funciona · 12 errores comunes que sabotean tu AEO', excerpt: 'FAQPage mal implementado empeora tu ranking. Aquí lo que sí hacer.', date: '2026-09-23', minutes: 6 },
  { slug: 'negocio-local-aeo-guia', title: 'Guía AEO para negocio local · restaurantes, spas, tiendas de barrio', excerpt: 'Todo lo específico para un negocio con dirección física. LocalBusiness, geo, NAP consistency.', date: '2026-09-23', minutes: 9 },
  { slug: 'saas-b2b-aparecer-en-ia', title: 'SaaS B2B · cómo aparecer cuando alguien le pregunta a la IA por tu categoría', excerpt: 'SoftwareApplication schema, comparativas técnicas, perfiles en review sites. La receta B2B.', date: '2026-09-23', minutes: 8 },
  { slug: 'robots-txt-para-ia', title: 'robots.txt para IAs · deja que ChatGPT, Claude y Perplexity te crawleen', excerpt: 'Cómo configurar robots.txt para dar bienvenida a los crawlers de IA. Plantilla lista.', date: '2026-09-23', minutes: 4 },
  { slug: 'auditor-aeo-como-funciona', title: 'Cómo funciona un auditor AEO por dentro', excerpt: 'De qué señales lee, cómo puntúa, qué NO puede medir todavía. Transparencia técnica.', date: '2026-09-23', minutes: 5 },
];

const featured = posts.filter(p => p.featured);
const rest = posts.filter(p => !p.featured);
---
<BaseLayout title="Blog · aprende AEO gratis" description="Todo lo que necesitas saber para que ChatGPT, Claude, Gemini y Perplexity recomienden tu negocio. Guías prácticas, en español, gratis.">
  <section class="container-lg pt-20 pb-10 md:pt-28">
    <p class="kicker mb-6 flex items-center gap-2">
      <Sparkle size={14} class="text-aurora-violet2" /> Blog Portalia
    </p>
    <h1 class="font-display text-4xl md:text-5xl font-semibold leading-[1.05] tracking-tight max-w-3xl">
      Aprende AEO / GEO <span class="text-grad-vc">gratis</span>, en español, sin humo.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-text-soft">
      Guías prácticas para hacer que las IAs recomienden tu negocio. Nuevo post cada semana.
    </p>
  </section>

  {featured.length > 0 && (
    <section class="container-lg pb-12">
      <p class="kicker mb-4">Destacados</p>
      <div class="grid gap-6 md:grid-cols-2">
        {featured.map(p => (
          <a href={`/blog/${p.slug}`} class="glass-strong rounded-2xl p-6 hover:-translate-y-1 transition flex flex-col">
            <span class="chip w-fit">Destacado</span>
            <h2 class="mt-3 font-display text-xl font-semibold">{p.title}</h2>
            <p class="mt-3 text-sm text-text-soft flex-1">{p.excerpt}</p>
            <p class="mt-4 text-xs text-text-mute">{p.date} · {p.minutes} min</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container-lg pb-24">
    <p class="kicker mb-4">Más artículos</p>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {rest.map(p => (
        <a href={`/blog/${p.slug}`} class="glass rounded-2xl p-6 hover:-translate-y-1 transition flex flex-col">
          <p class="text-xs text-text-mute">{p.date} · {p.minutes} min de lectura</p>
          <h2 class="mt-2 font-display text-lg font-semibold">{p.title}</h2>
          <p class="mt-3 text-sm text-text-soft flex-1">{p.excerpt}</p>
          <span class="mt-4 text-xs text-aurora-cyan">Leer →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
