---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sparkle from '@/components/Sparkle.astro';

const checkoutUrl = import.meta.env.PUBLIC_HOTMART_CHECKOUT_URL
  || 'https://pay.hotmart.com/W107728674K?off=92xsf4mj';

const pasos = [
  { n: 'C', t: 'Contextualiza', d: 'Define quién eres, qué haces y para quién, en el lenguaje que las IAs procesan.' },
  { n: 'I', t: 'Indexa', d: 'Estructura tu web con datos semánticos (Schema.org, JSON-LD) para que las IAs te "lean".' },
  { n: 'T', t: 'Testimonia', d: 'Consigue menciones externas — la señal más fuerte que una IA usa para recomendar.' },
  { n: 'A', t: 'Automatiza', d: 'Sistema de contenido AEO/GEO para que cada semana ganes citaciones sin esfuerzo manual.' },
  { n: 'R', t: 'Revisa', d: 'Audita cada 30 días con Portal IA y ajusta según cómo evolucionan los modelos.' },
];

const faq = [
  { q: '¿Esto es SEO?', a: 'No. El SEO tradicional optimiza para Google. AEO/GEO (Answer / Generative Engine Optimization) optimiza para IAs como ChatGPT, Claude, Perplexity o Gemini, que citan fuentes de forma distinta.' },
  { q: '¿Cuánto tarda en verse resultados?', a: 'Las primeras menciones aparecen entre 2 y 6 semanas. La consolidación (que te recomienden primero) toma 3–4 meses aplicando el método.' },
  { q: '¿Sirve si soy un negocio local?', a: 'Sí. De hecho es donde más rápido se ve impacto: hay menos competencia por la mención local en las IAs que en Google Maps.' },
  { q: '¿Tengo garantía?', a: 'Sí. 7 días de garantía Hotmart. Si no te sirve, te devolvemos el 100%.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  jsonLd={jsonLd}
  title="Método CITAR — que las IAs te recomienden"
  description="El sistema paso a paso para que ChatGPT, Claude, Gemini y Perplexity citen y recomienden tu negocio. Método CITAR completo."
>
  <section class="container-lg pt-20 pb-16 md:pt-28">
    <p class="kicker mb-6 flex items-center gap-2">
      <Sparkle size={14} class="text-aurora-violet2" /> Método CITAR
    </p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight max-w-4xl">
      Un método de <span class="text-grad-vc">5 pasos</span> para que las IAs
      empiecen a citarte por tu nombre.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-text-soft">
      Sin humo, sin promesas mágicas. La misma estructura que aplicamos en negocios reales
      para pasar de invisibles a fuente citada en semanas.
    </p>
  </section>

  <section class="container-lg py-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-5">
      {pasos.map((p) => (
        <div class="glass rounded-2xl p-6">
          <div class="w-12 h-12 rounded-xl bg-aurora-violet/20 border border-aurora-violet/40 grid place-items-center font-display font-semibold text-aurora-violet2 text-xl">{p.n}</div>
          <h3 class="mt-4 font-display text-lg font-semibold">{p.t}</h3>
          <p class="mt-2 text-sm text-text-soft">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-lg py-16">
    <p class="kicker mb-4">Qué recibes al comprar</p>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="glass rounded-2xl p-6">
        <h3 class="font-display text-xl font-semibold">Ebook completo</h3>
        <p class="mt-2 text-text-soft">
          + 120 páginas con el método CITAR paso a paso, plantillas de prompts, schemas listos para copiar,
          checklists de auditoría y casos reales.
        </p>
      </div>
      <div class="glass rounded-2xl p-6">
        <h3 class="font-display text-xl font-semibold">Acceso a la comunidad</h3>
        <p class="mt-2 text-text-soft">
          Foro privado con otros emprendedores aplicando el método. Actualizaciones cuando ChatGPT, Claude
          o Gemini cambian su ranking.
        </p>
      </div>
      <div class="glass rounded-2xl p-6">
        <h3 class="font-display text-xl font-semibold">Auditor Portal IA Pro</h3>
        <p class="mt-2 text-text-soft">
          Auditorías ilimitadas para tu web y las de tus clientes. Histórico de puntajes,
          detección de gaps semánticos.
        </p>
      </div>
      <div class="glass rounded-2xl p-6">
        <h3 class="font-display text-xl font-semibold">Programa de afiliados 60%</h3>
        <p class="mt-2 text-text-soft">
          Al comprar puedes revender Portalia. 60% de comisión, materiales de venta listos,
          tracking en Hotmart.
        </p>
      </div>
    </div>
  </section>

  <section class="container-lg py-16">
    <p class="kicker mb-4">Preguntas frecuentes</p>
    <div class="space-y-3">
      {faq.map((f) => (
        <details class="glass rounded-2xl px-6 py-4 group">
          <summary class="font-display text-base font-semibold cursor-pointer flex items-center justify-between">
            {f.q}
            <span class="text-aurora-cyan transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-text-soft text-sm">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-lg py-16">
    <div class="glass-strong rounded-3xl p-8 md:p-12 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-semibold max-w-2xl mx-auto">
        Deja de pelear con el algoritmo de Google. <span class="text-grad-vc">Empieza a hablarle a las IAs.</span>
      </h2>
      <a href={checkoutUrl} target="_blank" rel="noopener" class="btn-primary text-base px-7 py-3 mt-8 inline-flex">
        Comprar acceso — COP 39.900
      </a>
      <p class="mt-3 text-xs text-text-mute">Garantía 7 días · Pago seguro Hotmart</p>
    </div>
  </section>
</BaseLayout>
