---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IAVisibilitySim from '@/islands/IAVisibilitySim.tsx';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/prime/visibility-sim');
if (user.role !== 'buyer' && user.role !== 'admin') return Astro.redirect('/curso/bloqueado');
---
<BaseLayout title="Simulador · cómo te ve una IA — Prime" noindex={true}>
  <section class="container-lg pt-20 pb-6 md:pt-24">
    <a href="/prime" class="text-sm text-text-mute hover:text-text">← Zona Prime</a>
    <h1 class="mt-4 font-display text-3xl md:text-4xl font-semibold">Simulador · cómo te ve una IA</h1>
    <p class="mt-3 text-text-soft max-w-2xl">
      Marca las señales que tu web tiene hoy. El simulador estima si cada motor (ChatGPT, Claude, Gemini, Perplexity, Copilot) te menciona hoy.
      Heurística basada en 200+ auditorías reales.
    </p>
  </section>
  <section class="container-md pb-24">
    <IAVisibilitySim client:load />
  </section>
</BaseLayout>
