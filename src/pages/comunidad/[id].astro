---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LiveReplies from '@/islands/LiveReplies.tsx';
import { createSupabaseServerClient } from '@/lib/supabase';
import { CATEGORIES, MEMBER_ROLES, isUuid } from '@/lib/community';

const { id } = Astro.params;
if (!isUuid(id)) return new Response(null, { status: 404 });

const user = Astro.locals.user;
const isMember = !!user && MEMBER_ROLES.includes(user.role);
const supabase = createSupabaseServerClient(Astro.cookies);
let error: string | null = null;

if (Astro.request.method === 'POST') {
  if (!isMember) return Astro.redirect('/metodo');
  const form = await Astro.request.formData();
  const body = String(form.get('body') ?? '').trim().slice(0, 5000);
  if (body.length < 2) {
    error = 'Escribe una respuesta.';
  } else {
    const { error: insErr } = await supabase.from('replies').insert({ thread_id: id, author_id: user!.id, body });
    if (insErr) error = 'No se pudo publicar la respuesta. Intenta de nuevo.';
    else return Astro.redirect(`/comunidad/${id}#respuestas`, 303);
  }
}

let thread: any = null;
let rows: any[] | null = null;
try {
  const r1 = await supabase
    .from('threads')
    .select('id, title, body, category, created_at, author_name')
    .eq('id', id!)
    .maybeSingle();
  thread = r1.data;
  if (thread) {
    const r2 = await supabase
      .from('replies')
      .select('id, body, created_at, author_name')
      .eq('thread_id', id!)
      .order('created_at', { ascending: true })
      .limit(200);
    rows = r2.data;
  }
} catch (e) {
  console.error('comunidad/[id] error', e);
  return new Response(`Error cargando el hilo: ${e instanceof Error ? e.message : String(e)}`, { status: 503, headers: { 'content-type': 'text/plain; charset=utf-8' } });
}
if (!thread) {
  return Astro.redirect('/comunidad?hilo=no-encontrado', 302);
}

const replies = (rows ?? []).map((r: any) => ({ id: r.id, body: r.body, created_at: r.created_at, author: r.author_name || 'Miembro' }));
const t = thread as any;
const category = CATEGORIES.find((c) => c.id === t.category)?.label ?? t.category;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DiscussionForumPosting',
  headline: t.title,
  text: t.body.slice(0, 500),
  datePublished: t.created_at,
  author: { '@type': 'Person', name: t.author_name || 'Miembro' },
  commentCount: replies.length,
  url: new URL(`/comunidad/${t.id}`, Astro.site).toString(),
};
---
<BaseLayout title={`${t.title} — Comunidad Portalia`} description={t.body.slice(0, 150)} jsonLd={jsonLd}>
  <article class="container-md pt-16 pb-8 md:pt-24">
    <a href="/comunidad" class="text-xs text-aurora-cyan">← Comunidad</a>
    <div class="chip mt-6">{category}</div>
    <h1 class="mt-4 font-display text-3xl md:text-4xl font-semibold leading-tight">{t.title}</h1>
    <p class="mt-3 text-xs text-text-mute">{t.author_name || 'Miembro'} · {new Date(t.created_at).toLocaleDateString('es-CO', { dateStyle: 'long' })}</p>
    <div class="mt-8 text-text-soft whitespace-pre-line leading-relaxed">{t.body}</div>
  </article>

  <section id="respuestas" class="container-md pb-24">
    <h2 class="font-display text-xl font-semibold mb-4">Respuestas</h2>
    <LiveReplies
      client:load
      threadId={t.id}
      initial={replies}
      supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL ?? ''}
      anonKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''}
    />
    {isMember ? (
      <form method="POST" class="mt-8 glass rounded-2xl p-5 space-y-3">
        <label for="body" class="block text-xs uppercase tracking-widest text-text-mute">Tu respuesta</label>
        <textarea id="body" name="body" required rows="5" maxlength="5000" class="w-full bg-bg-elevated border border-border rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-aurora-violet"></textarea>
        {error && <p class="text-sm text-red-300">{error}</p>}
        <button type="submit" class="btn-primary text-sm px-5 py-2">Publicar respuesta</button>
      </form>
    ) : (
      <div class="mt-8 glass rounded-2xl p-5 text-sm text-text-soft">
        Responder es para miembros del método. <a href={user ? '/metodo' : '/login'} class="text-aurora-cyan">{user ? 'Ver el método →' : 'Inicia sesión →'}</a>
      </div>
    )}
  </section>
</BaseLayout>
