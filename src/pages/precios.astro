---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sparkle from '@/components/Sparkle.astro';

const checkoutUrl = import.meta.env.PUBLIC_HOTMART_CHECKOUT_URL || 'https://pay.hotmart.com/W107728674K?off=92xsf4mj';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Portalia · Método CITAR',
  description: 'Método, comunidad y auditor para que las IAs recomienden tu negocio.',
  brand: { '@type': 'Brand', name: 'Portalia' },
  offers: {
    '@type': 'Offer',
    price: '39900',
    priceCurrency: 'COP',
    availability: 'https://schema.org/InStock',
    url: 'https://portalia.com.co/metodo',
    priceValidUntil: '2026-12-31',
  },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '12' },
};
---
<BaseLayout title="Precios · Portalia" description="Un solo precio. Todo incluido. COP 39.900 con garantía 7 días." jsonLd={jsonLd}>
  <section class="container-lg pt-20 pb-6 md:pt-28">
    <p class="kicker mb-6 flex items-center gap-2">
      <Sparkle size={14} class="text-aurora-violet2" /> Precio
    </p>
    <h1 class="font-display text-3xl md:text-5xl font-semibold leading-[1.05] tracking-tight max-w-3xl">
      Un solo precio. <span class="text-grad-vc">Todo incluido.</span>
    </h1>
  </section>

  <section class="container-md py-12">
    <div class="glass-strong rounded-3xl p-8 md:p-12 text-center">
      <p class="text-text-mute line-through text-lg">COP 79.800</p>
      <p class="font-display text-6xl md:text-7xl font-semibold text-grad-vc mt-2">COP 39.900</p>
      <p class="text-text-soft mt-2">Lanzamiento (50% off)</p>

      <ul class="mt-8 grid gap-3 text-left max-w-md mx-auto">
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Ebook completo (120+ páginas)</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Método CITAR paso a paso</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Acceso comunidad Portalia</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Auditor Portal IA Pro</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Biblioteca de prompts CITAR</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Generador de Schema JSON-LD</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>6 arquetipos de arquitectura AEO</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Loop mensual + playbook completo</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>API sandbox para tus proyectos</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Programa afiliados 60%</li>
        <li class="flex gap-3 text-text-soft"><span class="text-emerald-400 shrink-0">✓</span>Actualizaciones futuras gratis</li>
      </ul>

      <a href={checkoutUrl} target="_blank" rel="noopener" class="btn-primary text-base px-7 py-3 mt-8 inline-flex">
        Comprar acceso · COP 39.900
      </a>
      <p class="mt-3 text-xs text-text-mute">Garantía 7 días Hotmart · Cupón PORTAL10 = 10% adicional</p>
    </div>
  </section>

  <section class="container-lg py-12">
    <div class="glass rounded-2xl p-6">
      <h2 class="font-display text-xl font-semibold">¿Por qué un solo precio?</h2>
      <p class="mt-3 text-text-soft">
        Cansados de productos con "Basic / Pro / Enterprise" donde lo que necesitas siempre está en el plan más caro.
        Portalia es un solo tier. Todo lo que necesitas para dominar AEO en tu negocio, sin upsells.
      </p>
    </div>
  </section>
</BaseLayout>
