---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sparkle from '@/components/Sparkle.astro';
import AuditorForm from '@/islands/AuditorForm.tsx';
---
<BaseLayout
  title="Auditor Portal IA — gratis"
  description="Descubre en 30 segundos por qué las IAs no están recomendando tu negocio. Auditor Portal IA gratuito."
>
  <section class="container-lg pt-20 pb-10 md:pt-28">
    <p class="kicker mb-6 flex items-center gap-2">
      <Sparkle size={14} class="text-aurora-violet2" /> Auditor Portal IA
    </p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight max-w-3xl">
      ¿Por qué las IAs <span class="text-grad-vc">no te recomiendan</span>?
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-text-soft">
      Ingresa tu URL y en 30 segundos obtienes un diagnóstico gratuito de tu presencia
      en Answer Engines (ChatGPT, Claude, Gemini, Perplexity, Copilot).
    </p>
  </section>

  <section class="container-md pb-24">
    <AuditorForm client:load />
  </section>
</BaseLayout>
